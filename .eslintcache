":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"162"},{"filePath":"314","messages":"315","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"162"},{"filePath":"316","messages":"317","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"162"},{"filePath":"318","messages":"319","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"162"},"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\index.js",[],["320","321"],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\App.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\reportWebVitals.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\configure.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\routes\\mainRoutes.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\context\\userContext.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\layout\\Header.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\auth\\WithAuth.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\post\\PostModal.js",["322"],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\Login\\PopUpSignIn.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\Login\\SignInUpModal.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\Group\\GroupStatistic.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\About\\Privacy.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\home\\HomePage.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\Profile\\UserStatistic.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\Profile\\UserConfig.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\Utility\\SessionStorageUtil.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\Group\\GroupPage.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\Group\\GroupList.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\Profile\\UserProfile.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\Group\\GroupAdmin.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\Login\\LoginPage.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\Utility\\Authenty.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\Utility\\Util.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\Login\\Register\\Step0.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\Login\\Register\\Step5.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\Login\\Register\\Step3.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\Login\\Register\\Step4.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\graphql-custom\\queries.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\graphql\\mutations.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\modal\\createpost\\CreatePostModal.js",["323","324"],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\modal\\notification\\NotificationModal.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\modal\\about\\AboutModal.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\Group\\GroupDashboard.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\pages\\Group\\GroupActivity.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\graphql\\subscriptions.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\Utility\\Validate.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\Utility\\Consts.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\group\\GroupAbout.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\group\\GroupHeader.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\group\\GroupPostArchive.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\group\\GroupSetting.js",["325"],"import TextFieldWithLabel from '../input/TextFieldWithLabel'\r\nimport SquareButtonWithIcon from '../buttons/general/SquareButtonWithIcon'\r\nimport Select, { components } from 'react-select';\r\nimport TextAreaWithLabel from '../input/TextAreaWithLabel'\r\nimport './css/GroupSetting.css'\r\nimport { useState, useEffect } from 'react'\r\nimport DefaultAvatar from \"../../resources/images/default_avatar.jpg\"\r\nimport RoundedButton from '../buttons/general/RoundedButton'\r\nimport { useUser } from '../../context/userContext'\r\nimport { API, graphqlOperation } from 'aws-amplify'\r\nimport { getGroupUsers } from '../../graphql-custom/queries';\r\nimport { updateGroup } from '../../graphql/mutations'\r\n\r\nfunction GroupSetting(props) {\r\n    const [checked, setChecked] = useState(0)\r\n    const [section, setSection] = useState('dashboard')\r\n    const [role, setRole] = useState('')\r\n    const [about, setAbout] = useState('')\r\n    const [groupabout, setGroupAbout] = useState('')\r\n    const {user} = useUser()\r\n    const pepe = ''\r\n    let userid = user.userdetail.id\r\n    let groupid = props.groupid\r\n    const saveGroupInfo = async () =>{\r\n        try{\r\n            await API.graphql(graphqlOperation(updateGroup, {input: {id: groupid, about: about}}))\r\n        }catch(ex){\r\n            console.log(\"GroupSetting-saveGroupInfo\", ex)\r\n        }\r\n    }\r\n    async function getUserGroup() {\r\n        try{\r\n            let groupname = await API.graphql(graphqlOperation(getGroupUsers, {group_id: groupid, user_id: userid} ))\r\n            let groupinfo = groupname.data.getGroupUsers\r\n            setRole(groupinfo.role)\r\n            setGroupAbout(groupinfo.group.about)\r\n        }catch(ex){\r\n            console.log('Groupsetting-getUserGroup', ex)\r\n        }\r\n    }\r\n    useEffect(() => {\r\n        getUserGroup()\r\n    }, [])\r\n    function handleCheck(e) {\r\n        console.log(e)\r\n        if (e.currentTarget.checked === true) {\r\n        if(checked >= 3) {\r\n            e.currentTarget.checked = false;\r\n        } else {\r\n            setChecked(checked + 1)\r\n        }\r\n        } else {\r\n        setChecked(checked - 1)\r\n        }\r\n    }\r\n    const options = [\r\n        { value: 'public', label: 'Нээлттэй групп', icon: \"fas fa-globe-americas\" },\r\n        { value: 'private', label: 'Хаалттай групп', icon: \"fas fa-lock\" }\r\n    ];\r\n    const { Option } = components;\r\n    const IconOption = props => (\r\n        <Option {...props}>\r\n          <i className={props.data.icon} alt={props.data.label}/>\r\n          {props.data.label}\r\n        </Option>\r\n    );\r\n    const customStyles = {\r\n        control: styles => ({ ...styles, backgroundColor: 'white', font: 'normal normal 500 20px/24px Montserrat', color: '#000' }),\r\n        option: (styles, { data, isDisabled, isFocused, isSelected }) => {\r\n          return {\r\n            ...styles,\r\n            width: '80%',\r\n            backgroundColor: isDisabled\r\n              ? null\r\n                : isFocused\r\n                    ? \"#F6F6F6\"\r\n                    : \"white\",\r\n            font: \"normal normal 500 20px/24px Montserrat\",\r\n            color: isDisabled\r\n              ? '#ccc'\r\n              : 'black',\r\n            cursor: isDisabled ? 'not-allowed' : 'default',\r\n            ':active': {\r\n              ...styles[':active'],\r\n              backgroundColor:\r\n                !isDisabled && (isSelected ? data.color : 'white'),\r\n            },\r\n          };\r\n        },\r\n    };\r\n    return(\r\n        <div className=\"settingOutDiv\">\r\n            {role === \"ADMIN\" ? \r\n                <div className=\"GroupSetting-main-window\">\r\n                    <div className=\"GroupSetting-main-wrapper\">\r\n                        <div className=\"GroupSetting-header\">\r\n                            <h3>Группын тохиргоо</h3>\r\n                        </div>\r\n                        <div className=\"dashboard-nav\">\r\n                            <p id=\"section-dashboard\" className={section === \"dashboard\" ? \"active-link\" : \"\"} onClick={() => {setSection(\"dashboard\")}}>Группын мэдээлэл</p>\r\n                            <p id=\"section-activity\" className={section === \"activity\" ? \"active-link\" : \"\"} onClick={() => {setSection(\"activity\")}}>Удирдагчид</p>\r\n                            <p id=\"section-log\" className={section === \"log\" ? \"active-link\" : \"\"} onClick={() => {setSection(\"log\")}}>Нууцлал</p>\r\n                        </div>\r\n                        {section === \"dashboard\" ? \r\n                            <div className=\"group-info\">\r\n                                <div className=\"group-info-header\">\r\n                                    <h4>Группын мэдээлэл</h4>\r\n                                </div>\r\n                                <TextFieldWithLabel defaultValue={props.name} label=\"Нэр\" placeholder=\"Нэр\" />\r\n                                <TextFieldWithLabel  defaultValue='@' label=\"Холбоос нэр\" placeholder=\"Холбоос нэр\" />\r\n                                <TextAreaWithLabel   label=\"Тухай\" defaultValue={groupabout} placeholder=\"Группын тухай бичнэ үү.\" onChange={(e) => setAbout(e.target.value)} />\r\n                                \r\n                                <TextFieldWithLabel  label=\"Утасны дугаар\" placeholder=\"Утас\" />\r\n                                <h4>Төрөл сонгох</h4>\r\n                                <div className=\"hobby side right\" style={{display: \"flex\", flexDirection:\"row\", flexWrap:\"wrap\",justifyContent:\"center\", width:\"100%\"}}>\r\n                                    <SquareButtonWithIcon check={handleCheck} icon=\"fa-clock\" content=\"Цаг үе\" id=\"1\" />\r\n                                    <SquareButtonWithIcon check={handleCheck} icon=\"fa-vest-patches\" content=\"Загварын ертөнц\" id=\"2\" />\r\n                                    <SquareButtonWithIcon check={handleCheck} icon=\"fa-info-circle\" content=\"Танин мэдэхүй\" id=\"3\" />\r\n                                    <SquareButtonWithIcon check={handleCheck} icon=\"fa-hiking\" content=\"Аялал\" id=\"4\" />\r\n                                    <SquareButtonWithIcon check={handleCheck} icon=\"fa-meteor\" content=\"Сансар огторгуй\" id=\"5\" />\r\n                                    <SquareButtonWithIcon check={handleCheck} icon=\"fa-graduation-cap\" content=\"Боловсрол\" id=\"6\" />\r\n                                    <SquareButtonWithIcon check={handleCheck} icon=\"fa-plus-square\" content=\"Эрүүл мэнд\" id=\"7\" />\r\n                                    <SquareButtonWithIcon check={handleCheck} icon=\"fa-hamburger\" content=\"Хоол\" id=\"8\" />\r\n                                    <SquareButtonWithIcon check={handleCheck} icon=\"fa-brain\" content=\"Сэтгэл судлал\" id=\"9\" />\r\n                                    <SquareButtonWithIcon check={handleCheck} icon=\"fa-cogs\" content=\"Технологи\" id=\"10\" />\r\n                                    <SquareButtonWithIcon check={handleCheck} icon=\"fa-running\" content=\"Спорт\" id=\"11\" />\r\n                                    <SquareButtonWithIcon check={handleCheck} icon=\"fa-microphone\" content=\"Подкаст\" id=\"12\" />\r\n                                    <SquareButtonWithIcon check={handleCheck} icon=\"fa-video\" content=\"Видео\" id=\"13\" />\r\n                                    <SquareButtonWithIcon check={handleCheck} icon=\"fa-music\" content=\"Дуу хөгжим\" id=\"14\" /> \r\n                                    <SquareButtonWithIcon check={handleCheck} icon=\"fa-film\" content=\"Кино\" id=\"15\" />\r\n                                    <SquareButtonWithIcon check={handleCheck} icon=\"fa-theater-masks\" content=\"Зугаа\" id=\"16\" />\r\n                                </div>\r\n                                <h4>Группын дүрэм</h4>\r\n                                <div className=\"rules\">\r\n                                    <TextFieldWithLabel  placeholder=\"Дүрэм 1\" />\r\n                                    <TextFieldWithLabel  placeholder=\"Дүрэм 2\" />\r\n                                    <TextFieldWithLabel  placeholder=\"Дүрэм 3\" />\r\n                                    <i className=\"fas fa-plus-circle\" />\r\n                                </div>\r\n                            </div>:\r\n                            section === \"activity\" ? \r\n                                <div className=\"group-leaders\">\r\n                                    <div className=\"group-leaders-header\">\r\n                                        <h4>Удирдагчид</h4>\r\n                                    </div>\r\n                                    <TextFieldWithLabel style={{marginTop: 40}} defaultValue={pepe} placeholder=\"Хайх хүнээ оруулна уу\" />\r\n                                    <div className=\"group-leaders-outDiv\">\r\n                                        <div className=\"group-leaders-list\">\r\n                                            <img src={DefaultAvatar} alt=\"leader\" />\r\n                                            <h2>Энхгэрэл Сүрэн</h2>\r\n                                            <select>\r\n                                                <option>Админ</option>\r\n                                                <option>Модедатор</option>\r\n                                                <option>Эдитор</option>\r\n                                                <option>Гишүүн</option>\r\n                                            </select>\r\n                                        </div>\r\n                                        <div className=\"group-leaders-list\">\r\n                                            <img src={DefaultAvatar} alt=\"leader\" />\r\n                                            <h2>Энхгэрэл Сүрэн</h2>\r\n                                            <select>\r\n                                                <option>Админ</option>\r\n                                                <option>Модедатор</option>\r\n                                                <option>Эдитор</option>\r\n                                                <option>Гишүүн</option>\r\n                                            </select>\r\n                                        </div>\r\n                                        <div className=\"group-leaders-list\">\r\n                                            <img src={DefaultAvatar} alt=\"leader\" />\r\n                                            <h2>Энхгэрэл Сүрэн</h2>\r\n                                            <select>\r\n                                                <option>Админ</option>\r\n                                                <option>Модедатор</option>\r\n                                                <option>Эдитор</option>\r\n                                                <option>Гишүүн</option>\r\n                                            </select>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>:\r\n                                section === \"log\" ? \r\n                                    <div className=\"group-privacy\">\r\n                                        <div className=\"group-privacy-header\">\r\n                                            <h4>Нууцлал</h4>\r\n                                        </div>\r\n                                        <div className=\"group-privacy-selection\">\r\n                                            <Select \r\n                                                styles={customStyles}\r\n                                                defaultValue={options[0]}\r\n                                                options={options}\r\n                                                components={{ Option: IconOption, SingleValue: IconOption }}\r\n                                                isSearchable={false}\r\n                                            />\r\n                                        </div>\r\n                                        <div className=\"group-privacy-checkbox\">\r\n                                            <label htmlFor=\"\">Дүрэм ил харуулах</label>\r\n                                            <input type=\"checkbox\" name=\"user-show-joined-groups\" id=\"user-show-joined-groups\"></input>\r\n                                        </div>\r\n                                        <div className=\"group-privacy-checkbox\">\r\n                                            <label htmlFor=\"\">Удирдагчдийг ил харуулах</label>\r\n                                            <input type=\"checkbox\" name=\"user-show-created-groups\" id=\"user-show-created-groups\"></input>\r\n                                        </div>\r\n                                    </div>:\r\n                                    <></>}                    \r\n                    </div>\r\n                    <div className=\"group-buttons\">\r\n                            <RoundedButton content=\"Болих\" />\r\n                            <RoundedButton content=\"Хадгалах\" onClick={() => saveGroupInfo()}/>\r\n                    </div>\r\n                </div>:\r\n                <p>Permission Denied</p>\r\n            }\r\n            \r\n        </div>\r\n    )\r\n}\r\n\r\nexport default GroupSetting","C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\group\\groupprofile\\groupprofileright.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\group\\GroupPost.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\group\\groupstatistic\\Groupmemberlog1.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\home\\Post.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\home\\RecommendedTag.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\profile\\UserSidebar.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\profile\\UserActivity.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\input\\TextAreaWithLabel.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\modal\\profile\\DeleteProfileModal.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\profile\\UserDashboard.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\profile\\UserLog.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\input\\TextFieldWithLabel.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\group\\RightSide\\GroupMembers.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\group\\RightSide\\GroupLeaders.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\group\\RightSide\\GroupDesc.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\group\\RightSide\\GroupBottom.js",[],"C:\\Users\\Tengis' PC\\Documents\\work\\caak\\caak-react\\src\\component\\group\\RightSide\